{
  "name": "nuxt-buggregator",
  "version": "1.0.0",
  "description": "Nuxt module for debugging with Buggregator via Spatie Ray protocol",
  "keywords": [
    "buggregator",
    "debugging",
    "devtools",
    "nuxt",
    "nuxt-module",
    "ray"
  ],
  "homepage": "https://github.com/Semdevmaster/nuxt-buggregator#readme",
  "bugs": {
    "url": "https://github.com/Semdevmaster/nuxt-buggregator/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Semdevmaster/nuxt-buggregator.git"
  },
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepare": "vp config --no-hooks",
    "prepack": "nuxt-module-build build",
    "dev": "bun run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "bun run check && bun run test && bun run prepack && changelogen --release && npm publish && git push --follow-tags",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "typecheck": "vp check --no-fmt",
    "validate": "bun run dev:prepare && vp check"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.0",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.3.1",
    "@nuxt/eslint-plugin": "^1.16.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.0",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vue/language-server": "^3.3.8",
    "@vue/typescript-plugin": "^3.3.8",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.0",
    "oxlint": "1.75.0",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
